# --- Suite-wide ---------------------------------------------------------
# Tiap app WAJIB punya DATABASE_URL sendiri (satu DB per app — tidak berbagi schema).
# Postgres & Redis dari infra/docker-compose.yml.
POSTGRES_USER=portico
POSTGRES_PASSWORD=portico_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379

# --- Hub (identity provider + control plane) ---------------------------
HUB_DATABASE_URL=postgresql://portico:portico_dev@localhost:5432/portico_hub
HUB_BASE_URL=http://localhost:3100
# RS256 keypair. Generate: npm run -w @portico/hub keys:generate
# Isi path atau tempel PEM langsung (baris baru jadi \n).
HUB_JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
HUB_JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
HUB_JWT_KID=dev-1
HUB_SESSION_SECRET=ganti-dengan-32-byte-acak

# --- App A / B / C ------------------------------------------------------
# Satu DB per app. Jangan digabung.
PLATFORM_DATABASE_URL=postgresql://portico:portico_dev@localhost:5432/portico_platform
HELPDESK_DATABASE_URL=postgresql://portico:portico_dev@localhost:5432/portico_helpdesk
CODEREVIEW_DATABASE_URL=postgresql://portico:portico_dev@localhost:5432/portico_codereview

# Client per app, didaftarkan di Hub. Secret hanya dipakai di server app.
PLATFORM_CLIENT_ID=platform
PLATFORM_CLIENT_SECRET=dev-platform-secret
PLATFORM_BASE_URL=http://localhost:3001

HELPDESK_CLIENT_ID=helpdesk
HELPDESK_CLIENT_SECRET=dev-helpdesk-secret
HELPDESK_BASE_URL=http://localhost:3002

CODEREVIEW_CLIENT_ID=code-review
CODEREVIEW_CLIENT_SECRET=dev-codereview-secret
CODEREVIEW_BASE_URL=http://localhost:3003

# Titik sambung ke Hub. Kosongkan untuk menguji mode "Hub mati".
HUB_ISSUER=http://localhost:3100
HUB_JWKS_URL=http://localhost:3100/.well-known/jwks.json

# --- LLM (A + B + C) ----------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Batas biaya per workspace di A (US-A: cap 15)
AI_MONTHLY_CAP_USD=15

# --- Observabilitas -----------------------------------------------------
# Token bearer untuk /api/metrics. Jangan taruh di query string.
METRICS_TOKEN=dev-metrics-token

# --- C: GitHub App ------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
